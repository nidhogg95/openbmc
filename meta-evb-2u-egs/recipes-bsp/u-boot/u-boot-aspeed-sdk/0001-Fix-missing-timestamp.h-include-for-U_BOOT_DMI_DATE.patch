From 5ef422aef933820dba1b6b9cb20b741c1d93530f Mon Sep 17 00:00:00 2001
From: Your Name <your_email@example.com>
Date: Tue, 14 Apr 2026 13:54:53 +0800
Subject: [PATCH] Fix missing timestamp.h include for U_BOOT_DMI_DATE

lib/smbios.c uses U_BOOT_DMI_DATE which is defined in
generated/timestamp_autogenerated.h, included via timestamp.h.
However, smbios.c only includes version.h which does not pull in
timestamp.h, causing a build failure with GCC 15:

  lib/smbios.c:84:58: error: 'U_BOOT_DMI_DATE' undeclared

Similarly, version.h itself uses U_BOOT_DATE, U_BOOT_TIME, and
U_BOOT_TZ macros from timestamp_autogenerated.h but never includes it.

Add the missing include to both files.

Upstream-Status: Pending
Signed-off-by: OpenBMC Developer <openbmc@openbmc.org>
---
 include/version.h | 1 +
 lib/smbios.c      | 1 +
 2 files changed, 2 insertions(+)

diff --git a/include/version.h b/include/version.h
index 66845ef0c2..ce4373e3c0 100644
--- a/include/version.h
+++ b/include/version.h
@@ -9,6 +9,7 @@
 
 #ifndef DO_DEPS_ONLY
 #include "generated/version_autogenerated.h"
+#include "generated/timestamp_autogenerated.h"
 #endif
 
 #define U_BOOT_VERSION_STRING U_BOOT_VERSION " (" U_BOOT_DATE " - " \
diff --git a/lib/smbios.c b/lib/smbios.c
index e8ee55c4ae..84aca3fca4 100644
--- a/lib/smbios.c
+++ b/lib/smbios.c
@@ -10,6 +10,7 @@
 #include <smbios.h>
 #include <tables_csum.h>
 #include <version.h>
+#include <timestamp.h>
 #ifdef CONFIG_CPU
 #include <cpu.h>
 #include <dm.h>
