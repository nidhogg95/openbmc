            "type": "fan",
            "readPath": "/xyz/openbmc_project/sensors/fan_tach/Fan_0",
            "writePath": "/xyz/openbmc_project/control/fanpwm/Fan_0",
            "min": 0,
            "max": 255
        },
        {
            "name": "fan1",
